PORT=5000

# OPTION 1: Local MongoDB Connection (if you have local mongod or Docker running)
# MONGODB_URI=mongodb://127.0.0.1:27017/clothing_swap

# OPTION 2: MongoDB Atlas Free Cloud Database (Recommended for live deployment)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/clothing_swap?retryWrites=true&w=majority

# When MONGODB_URI is provided, the server automatically connects to MongoDB via Mongoose and seeds the initial fashion catalog!
# If left commented out, the server runs with built-in instant persistence and realistic data.
